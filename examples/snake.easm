segment: code

function main:
    ADD   r12, r15, 12
    JMP   drawBackground

  game_loop:
    ADD   r12, r15, 12
    JMP   updateDirection
    
    ADD   r12, r15, 12
    JMP   move

    ADD   r12, r15, 12
    JMP   generateFood

    ADD   r12, r15, 12
    JMP   drawSnake

    ADD   r12, r15, 12
    JMP   drawFood

    ADD   r12, r15, 12
    JMP   sleep

    JMP   game_loop

function generateFood:
    LD    r1, $food_eaten(r0)
    BNE   generate
    JMP   r12

  generate:
    RAND  r1, 1, 126
    RAND  r2, 1, 40
    JMP   end

    LD    r3, $size(r0)
    SUB   r3, r3, 1
    MUL   r3, r3, 4
    ADD   r3, r3, $head_pos_x

  loop:
    LD    r4, (r3)
    LD    r5, 4(r3)
    
    SUB   r4, r4, r1
    SUB   r5, r5, r2
    OR    r4, r4, r5
    BE    generate

    SUB   r3, r3, 8
    SUB   r0, r3, $head_pos_x
    BGE   loop

  end:
    ST    $food_eaten(r0), r0
    ST    $food_pos_x(r0), r1
    ST    $food_pos_y(r0), r2
    JMP r12

function move:
  # move tail
    ADD   r1, r0, $head_pos_x   # r1 = address of coords
    LD    r2, $size(r0)         # r2 = number of coords
    SUB   r2, r2, 1             # r2 = number of coords - 1

  loop:
    MUL   r3, r2, 8
    ADD   r3, r3, r1            # r3 = coord addr

    LD    r4, 0(r3)             # r4 = old pos x
    LD    r5, 4(r3)             # r4 = old pos y

    ST    8(r3), r4
    ST    12(r3), r5

    SUB   r2, r2, 1
    BGE   loop

  # move head to new pos in direction
    LD    r1, $head_pos_x(r0)
    LD    r2, $head_pos_y(r0)
    LD    r3, $direction_char(r0)

    SUB   r0, r3, 0x77      # r3 == 'w'
    BNE   try_a
    SUB   r2, r2, 1
    JMP   end
    
  try_a:
    SUB   r0, r3, 0x61      # r3 == 'a'
    BNE   try_s
    SUB   r1, r1, 1
    JMP   end
    
  try_s:
    SUB   r0, r3, 0x73      # r3 == 's'
    BNE   try_d
    ADD   r2, r2, 1
    JMP   end

  # had to be 'd' now, no need to check
  try_d:
    ADD   r1, r1, 1
    
  end:
    LD    r3, $food_pos_x(r0)
    LD    r4, $food_pos_y(r0)

    SUB   r0, r3, r1
    BNE   store
    SUB   r0, r4, r2
    BNE   store

    ADD   r5, r0, 1
    ST    $food_eaten(r0), r5

  store:
    ST    $head_pos_x(r0), r1
    ST    $head_pos_y(r0), r2
    
    JMP   r12

function sleep:
    ADD   r1, r0, 100000
    LD    r3, $direction_char(r0)

    SUB   r0, r3, 0x61      # r3 == 'a'
    BE    loop
    SUB   r0, r3, 0x64      # r3 == 'd'
    BE    loop

  double_time:
    MUL   r1, r1, 2
  
  loop:
    SUB   r1, r1, 1
    BNE   loop
    
    JMP   r12

function updateDirection:
  event_loop:
    LD    r1, 0x7104(r0)    # r1 = size
    BNE   check_event
    JMP   r12

  check_event:
    LD    r2, 0x7100(r0)    # r2 = begin
    LD.B  r3, 0x7000(r2)    # r3 = event

    SUB   r0, r3, 0x77      # r3 == 'w'
    BE    store_direction
    SUB   r0, r3, 0x61      # r3 == 'a'
    BE    store_direction
    SUB   r0, r3, 0x73      # r3 == 's'
    BE    store_direction
    SUB   r0, r3, 0x64      # r3 == 'd'
    BNE   consume_event

  store_direction:
    ST    $direction_char(r0), r3

  consume_event:
    ADD   r2, r2, 1         # r2 = begin + 1
    REM   r2, r2, 256       # r2 = (begin + 1) % 256
    SUB   r1, r1, 1         # r1 = size - 1
    ST    0x7104(r0), r1
    ST    0x7100(r0), r2
    JMP   event_loop

function drawSnake:
  # draw head
    ADD   r1, r0, 0x1FFF32    # green color
    ADD   r2, r0, 0x40        # @-sign
    
    LD    r3, $head_pos_x(r0) # r3 = head pos x
    LD    r4, $head_pos_y(r0) # r4 = head pos y

    MUL   r5, r4, 128         # r5 = console index
    ADD   r5, r5, r3
    MUL   r5, r5, 4

    ST    0x1000(r5), r1
    ST.B  0x1003(r5), r2

  # clear old tail
    LD    r1, $size(r0)         # r1 = size
    MUL   r1, r1, 8             # r1 = old tail coord index
    ADD   r1, r1, $head_pos_x   # r1 = old tail coord address
    
    LD    r4, (r1)              # r4 = x
    LD    r5, 4(r1)             # r5 = y
    MUL   r5, r5, 128           # r5 = console index
    ADD   r5, r5, r4
    MUL   r5, r5, 4

    ST    0x1000(r5), r0
    ST.B  0x1003(r5), r0
  
  # draw remaining body
    ADD   r2, r0, 0x389620      # darker green color
    ADD   r3, r0, 0x4f          # 'O' char
    SUB   r1, r1, 8
    
    SUB   r0, r1, $head_pos_x
    BE    end
    
  loop:
    LD    r4, (r1)              # r4 = x
    LD    r5, 4(r1)             # r5 = y
    MUL   r5, r5, 128           # r5 = console index
    ADD   r5, r5, r4
    MUL   r5, r5, 4

    ST    0x1000(r5), r2
    ST.B  0x1003(r5), r3

    SUB   r1, r1, 8
    SUB   r0, r1, $head_pos_x
    BNE   loop

  end:
    JMP   r12

function drawBackground:
    ADD   r1, r0, 0x7D6E64    # grey color
    ADD   r2, r0, 0x23        # #-sign

    ADD   r3, r0, r0          # y coord
  
  outer:
    ADD   r4, r0, r0          # x coord
  
  inner:
    MUL   r5, r3, 128         # index
    ADD   r5, r5, r4
    MUL   r5, r5, 4

    SUB   r0, r4, r0
    BE    draw_wall
    SUB   r0, r4, 127
    BE    draw_wall
    SUB   r0, r3, r0
    BE    draw_wall
    SUB   r0, r3, 41
    BNE   draw_nothing

  draw_wall:
    ST    0x1000(r5), r1
    ST.B  0x1003(r5), r2

    JMP   inner_end

  draw_nothing:
    ST    0x1000(r5), r0

  inner_end:
    ADD   r4, r4, 1
    SUB   r0, r4, 128
    BNE   inner

  outer_end:
    ADD   r3, r3, 1
    SUB   r0, r3, 42
    BNE   outer

  end:
    JMP   r12

function drawFood:
    LD    r1, $food_eaten(r0)
    BNE   end

    LD    r1, $food_pos_x(r0)
    LD    r2, $food_pos_y(r0)

    MUL   r3, r2, 128
    ADD   r3, r3, r1
    MUL   r3, r3, 4

    ADD   r4, r0, 0x0000FF      # color red
    ADD   r5, r0, 0x2A          # '*' char

    ST    0x1000(r3), r4
    ST.B  0x1003(r3), r5

  end:
    JMP   r12

segment: data
  direction_char  = "d"
  food_eaten      = 1
  food_pos_x      = 0
  food_pos_y      = 0
  size            = 5
  head_pos_x      = 64
  head_pos_y      = 21
  initial_tail_cells      = 63, 21,   62, 21,   61, 21,   60, 21
  initial_old_tail_cell   = 59, 21
