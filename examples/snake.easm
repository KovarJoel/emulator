segment: code

function main:
    ADD   r12, r15, 12
    JMP   drawBackground

  game_loop:
    ADD   r12, r15, 12
    JMP   updateDirection
    
    ADD   r12, r15, 12
    JMP   move

    ADD   r12, r15, 12
    JMP   generateFood

    ADD   r12, r15, 12
    JMP   drawSnake

    ADD   r12, r15, 12
    JMP   drawFood

    ADD   r12, r15, 12
    JMP   sleep

    JMP   game_loop

# arg1: number
# arg2: start x
# arg3: start y
# ret1: success
# ret2: next start x
# ret3: next start y
function printUnsigned:
    ADD   r4, r0, 0xFFFFFFu
    ADD   r5, r0, "0"

    SUB   r0, r1, r0
    BNE   start

    MUL   r6, r3, 128
    ADD   r6, r6, r2
    MUL   r6, r6, 4
    ADD   r6, r6, 0x1000

    ST    (r6), r4
    ST.B  3(r6), r5
    ADD   r1, r0, r1
    JMP   end

  start:
    ADD   r5, r0, r13

  loop_convert:
    REM   r7, r1, 10
    ADD   r7, r7, "0"

    SUB   r13, r13, 4
    ST    (r13), r7

    DIV   r1, r1, 10
    BNE   loop_convert

  loop_print:
    LD    r7, (r13)
    ADD   r13, r13, 4

    MUL   r6, r3, 128
    ADD   r6, r6, r2
    MUL   r6, r6, 4
    ADD   r6, r6, 0x1000

    ST    (r6), r4
    ST.B  3(r6), r7

    ADD   r2, r2, 1
    SUB   r0, r2, 128
    BNE   end_loop

    ADD   r2, r0, r0
    ADD   r3, r3, 1
    SUB   r0, r3, 42
    BNE   end_loop

    ADD   r1, r0, r0
    JMP   end

  end_loop:
    SUB   r0, r13, r5
    BNE   loop_print
  
    ADD   r1, r0, r1

  end:
    JMP   r12

# arg1: pointer to null-terminated string
# arg2: start x
# arg3: start y
# ret1: success
# ret2: next start x
# ret3: next start y
function printString:
    SUB   r0, r1, r0
    BNE   start
    
    ADD   r1, r0, r0
    JMP   end
    
  start:
    ADD   r4, r0, 0xFFFFFFu   # color white

  loop:
    LD.B  r5, (r1)
    BE    end

    MUL   r6, r3, 128
    ADD   r6, r6, r2
    MUL   r6, r6, 4
    ADD   r6, r6, 0x1000

    ST    (r6), r4
    ST.B  3(r6), r5

    ADD   r2, r2, 1
    SUB   r0, r2, 128
    BNE   end_loop

    ADD   r2, r0, r0
    ADD   r3, r3, 1
    SUB   r0, r3, 42
    BNE   end_loop

    ADD   r1, r0, r0
    JMP   end

  end_loop:
    ADD   r1, r1, 1
    JMP   loop

    ADD   r1, r0, 1
  
  end:
    JMP   r12

function gameEnd:
    ADD   r1, r0, $score_string
    ADD   r2, r0, 50
    ADD   r3, r0, 21
    ADD   r12, r15, 12
    JMP   printString

    LD    r1, $size(r0)
    ADD   r12, r15, 12
    JMP   printUnsigned

    HALT

function generateFood:
    LD    r1, $food_eaten(r0)
    BNE   generate
    JMP   r12

  generate:
    RAND  r1, 1, 126
    RAND  r2, 1, 40

    LD    r3, $size(r0)
    SUB   r3, r3, 1
    MUL   r3, r3, 8
    ADD   r3, r3, $head_pos_x

  loop:
    LD    r4, (r3)
    LD    r5, 4(r3)
    
    SUB   r4, r4, r1
    SUB   r5, r5, r2
    OR    r0, r4, r5
    BE    generate

    SUB   r3, r3, 8
    SUB   r0, r3, $head_pos_x
    BGE   loop

  end:
    ST    $food_eaten(r0), r0
    ST    $food_pos_x(r0), r1
    ST    $food_pos_y(r0), r2
    JMP   r12

function move:
  # move head to new pos in direction
    LD    r1, $head_pos_x(r0)
    LD    r2, $head_pos_y(r0)
    LD    r3, $direction_char(r0)

    SUB   r0, r3, "w"
    BNE   try_a
    SUB   r2, r2, 1
    JMP   check_for_food
    
  try_a:
    SUB   r0, r3, "a"
    BNE   try_s
    SUB   r1, r1, 1
    JMP   check_for_food
    
  try_s:
    SUB   r0, r3, "s"
    BNE   try_d
    ADD   r2, r2, 1
    JMP   check_for_food

  # has to be 'd' now, no need to check
  try_d:
    ADD   r1, r1, 1
    
  check_for_food:
    LD    r3, $food_pos_x(r0)
    LD    r4, $food_pos_y(r0)

    # save new head pos on stack
    SUB   r13, r13, 8
    ST    4(r13), r1
    ST    (r13), r2

    SUB   r0, r3, r1
    BNE   move_tail
    SUB   r0, r4, r2
    BNE   move_tail

    ADD   r5, r0, 1
    ST    $food_eaten(r0), r5
    LD    r1, $size(r0)
    ADD   r1, r1, r5
    ST    $size(r0), r1

  move_tail:
    ADD   r1, r0, $head_pos_x   # r1 = address of coords
    LD    r2, $size(r0)         # r2 = number of coords
    SUB   r2, r2, 1             # r2 = number of coords - 1

  loop:
    MUL   r3, r2, 8
    ADD   r3, r3, r1            # r3 = coord addr

    LD    r4, 0(r3)             # r4 = old pos x
    LD    r5, 4(r3)             # r4 = old pos y

    ST    8(r3), r4
    ST    12(r3), r5

    SUB   r2, r2, 1
    BGE   loop

  store_head:
    LD    r1, 4(r13)
    LD    r2, (r13)
    ADD   r13, r13, 8

    ST    $head_pos_x(r0), r1
    ST    $head_pos_y(r0), r2

  check_game_end:
  check_collision_walls:
    SUB   r0, r1, 0
    BLE   call_game_end
    SUB   r0, r1, 127
    BGE   call_game_end
    SUB   r0, r2, 0
    BLE   call_game_end
    SUB   r0, r2, 41
    BGE   call_game_end
  check_size:
    LD    r3, $size(r0)
    ADD   r4, r0, 126
    MUL   r4, r4, 40
    SUB   r0, r3, r4
    BE    call_game_end
  check_collision_self:
    ADD   r3, r0, 1
    LD    r6, $size(r0)
  loop_self_collision:
    MUL   r4, r3, 8
    ADD   r4, r4, $head_pos_x
    LD    r5, (r4)
    SUB   r0, r5, r1
    BNE   end_loop_self_collision
    LD    r5, 4(r4)
    SUB   r0, r5, r2
    BNE   end_loop_self_collision
    JMP call_game_end
  end_loop_self_collision:
    ADD   r3, r3, 1
    SUB   r0, r3, r6
    BNE   loop_self_collision

    JMP end_move
  call_game_end:
    ADD   r12, r15, 12
    JMP   gameEnd

  end_move:
    JMP   r12

function sleep:
    ADD   r1, r0, 100000
    LD    r3, $direction_char(r0)

    SUB   r0, r3, "a"
    BE    loop
    SUB   r0, r3, "d"
    BE    loop

  double_time:
    MUL   r1, r1, 2
  
  loop:
    SUB   r1, r1, 1
    BNE   loop
    
    JMP   r12

function updateDirection:
    ADD   r4, r0, r0
    LD    r5, $direction_char(r0)

  event_loop:
    LD    r1, 0x7104(r0)    # r1 = size
    BNE   check_event
    JMP   r12

  check_event:
    LD    r2, 0x7100(r0)    # r2 = begin
    LD.B  r3, 0x7000(r2)    # r3 = event

    SUB   r0, r3, r5        # new direction == old direction
    BE    consume_event     

    SUB   r0, r3, "w"
    BNE   try_a
    SUB   r0, r5, "s"
    BE    consume_event
    JMP   store_direction
  try_a:
    SUB   r0, r3, "a"
    BNE   try_s
    SUB   r0, r5, "d"
    BE    consume_event
    JMP   store_direction
  try_s:
    SUB   r0, r3, "s"
    BNE   try_d
    SUB   r0, r5, "w"
    BE    consume_event
    JMP   store_direction
  try_d:
    SUB   r0, r3, "d"
    BNE   consume_event
    SUB   r0, r5, "a"
    BE    consume_event
    JMP   store_direction

  store_direction:
    ST    $direction_char(r0), r3
    ADD   r4, r0, 1

  consume_event:
    ADD   r2, r2, 1         # r2 = begin + 1
    REM   r2, r2, 256       # r2 = (begin + 1) % 256
    SUB   r1, r1, 1         # r1 = size - 1
    ST    0x7104(r0), r1
    ST    0x7100(r0), r2

    SUB   r0, r4, 1
    BE    end
    JMP   event_loop

  end:
    JMP   r12

function drawSnake:
  # draw head
    ADD   r1, r0, 0x1FFF32    # green color
    ADD   r2, r0, "@"
    
    LD    r3, $head_pos_x(r0) # r3 = head pos x
    LD    r4, $head_pos_y(r0) # r4 = head pos y

    MUL   r5, r4, 128         # r5 = console index
    ADD   r5, r5, r3
    MUL   r5, r5, 4

    ST    0x1000(r5), r1
    ST.B  0x1003(r5), r2

  # clear old tail
    LD    r1, $size(r0)         # r1 = size
    MUL   r1, r1, 8             # r1 = old tail coord index
    ADD   r1, r1, $head_pos_x   # r1 = old tail coord address
    
    LD    r4, (r1)              # r4 = x
    LD    r5, 4(r1)             # r5 = y
    MUL   r5, r5, 128           # r5 = console index
    ADD   r5, r5, r4
    MUL   r5, r5, 4

    ST    0x1000(r5), r0
    ST.B  0x1003(r5), r0
  
  # draw remaining body
    ADD   r2, r0, 0x389620      # darker green color
    ADD   r3, r0, "O"
    SUB   r1, r1, 8
    
    SUB   r0, r1, $head_pos_x
    BE    end
    
  loop:
    LD    r4, (r1)              # r4 = x
    LD    r5, 4(r1)             # r5 = y
    MUL   r5, r5, 128           # r5 = console index
    ADD   r5, r5, r4
    MUL   r5, r5, 4

    ST    0x1000(r5), r2
    ST.B  0x1003(r5), r3

    SUB   r1, r1, 8
    SUB   r0, r1, $head_pos_x
    BNE   loop

  end:
    JMP   r12

function drawBackground:
    ADD   r1, r0, 0x7D6E64    # grey color
    ADD   r2, r0, "#"

    ADD   r3, r0, r0          # y coord
  
  outer:
    ADD   r4, r0, r0          # x coord
  
  inner:
    MUL   r5, r3, 128         # index
    ADD   r5, r5, r4
    MUL   r5, r5, 4

    SUB   r0, r4, r0
    BE    draw_wall
    SUB   r0, r4, 127
    BE    draw_wall
    SUB   r0, r3, r0
    BE    draw_wall
    SUB   r0, r3, 41
    BNE   draw_nothing

  draw_wall:
    ST    0x1000(r5), r1
    ST.B  0x1003(r5), r2

    JMP   inner_end

  draw_nothing:
    ST    0x1000(r5), r0

  inner_end:
    ADD   r4, r4, 1
    SUB   r0, r4, 128
    BNE   inner

  outer_end:
    ADD   r3, r3, 1
    SUB   r0, r3, 42
    BNE   outer

  end:
    JMP   r12

function drawFood:
    LD    r1, $food_eaten(r0)
    BNE   end

    LD    r1, $food_pos_x(r0)
    LD    r2, $food_pos_y(r0)

    MUL   r3, r2, 128
    ADD   r3, r3, r1
    MUL   r3, r3, 4

    ADD   r4, r0, 0x0000FF      # color red
    ADD   r5, r0, "*"

    ST    0x1000(r3), r4
    ST.B  0x1003(r3), r5

  end:
    JMP   r12

segment: data
  score_string.B  = "Game Ended... Your score: ", 0x00
  direction_char  = "d"
  food_eaten      = 1
  food_pos_x      = 0
  food_pos_y      = 0
  size            = 5
  head_pos_x      = 64
  head_pos_y      = 21
  initial_tail_cells      = 63, 21,   62, 21,   61, 21,   60, 21
  initial_old_tail_cell   = 59, 21
