segment: code

function main:
    ADDI    r1, r0, $cells
    JMPI    r12, generateInitialCells

  loop:
  draw:
    LDI     r1, r0, $active_cells_index
    ADDI    r2, r0, 5376      # offset = 128 * 42
    MUL     r2, r2, r1        # offset = active_cells_index == 0 ? 0 : 5376

    ADDI    r1, r2, $cells
    JMPI    r12, drawCells

  apply_rules:
    LDI     r1, r0, $active_cells_index
    ADDI    r2, r0, 5376      # offset = 128 * 42
    
    MUL     r3, r2, r1        # active_offset = active_cells_index == 0 ? 0 : 5376
    
    XORI    r1, r1, 1
    MUL     r4, r2, r1        # inactive_offset = active_cells_index == 1 ? 0 : 5376

    ADDI    r1, r3, $cells
    ADDI    r2, r4, $cells
    JMPI    r12, applyRules

  swap_cells:
    LDI     r1, r0, $active_cells_index
    XORI    r1, r1, 1                     # active_cells_index = !active_cells_index
    STI     r1, r0, $active_cells_index

  end:
    B       A, loop

# arg1: ptr to active cells
# arg2: x
# arg3: y
# ret1: alive neighbours count
function countAliveNeighbours:
    ADD     r7, r0, r0        # count = 0
    ADDI    r2, r2, 1         # last x = input x + 1
    ADDI    r3, r3, 1         # last y = input y + 1

    SUBI    r4, r3, 2         # y = last y - 2
    
  outer:
    SUBI    r5, r2, 2         # x = last x - 2

  inner:
    SUB     r0, r5, r0        # if (x < 0)
    B       LT, loop_increment    #   continue
    SUBI    r0, r5, 128       # if (x >= 128)
    B       GE, loop_increment    #   continue

    SUB     r0, r4, r0        # if (y < 0)
    B       LT, loop_increment    #   continue
    SUBI    r0, r4, 42        # if (y >= 42)
    B       GE, loop_increment    #   continue

    SUBI    r6, r2, 1
    SUB     r0, r5, r6        # if (x != input x)
    B       NE, check_alive

    SUBI    r6, r3, 1
    SUB     r0, r4, r6        # if (y == input y)
    B       E, loop_increment

  check_alive:
    MULI    r6, r4, 128
    ADD     r6, r6, r5        # index = y * 128 + x
    LDB     r6, r1, r6      # cell = cells[index]
    B       E, loop_increment    # if (!cell) continue

    ADDI    r7, r7, 1         # count = cout + 1

  loop_increment:
    ADDI    r5, r5, 1         # x = x + 1
    SUB     r0, r5, r2        # if (x <= last x)
    B       LE, inner             #   goto inner

    ADDI    r4, r4, 1         # y = y + 1
    SUB     r0, r4, r3        # if (y <= last y)
    B       LE, outer             #   goto outer

    ADD     r1, r0, r7        # ret1 = count
    JMPR    r0, r12, 0               # ret

# arg1: ptr to active cells
# arg2: ptr to inactive cells
# arg3: x
# arg4: y
function applyRulesToCell:
    SUBI    r13, r13, 20
    STI     r1, r13, 00
    STI     r2, r13, 04
    STI     r3, r13, 08
    STI     r4, r13, 12
    STI     r12, r13, 16

    ADD     r2, r0, r3
    ADD     r3, r0, r4
    JMPI    r12, countAliveNeighbours
    ADD     r5, r0, r1              # count = countAliveNeighbours()

    LDI     r1, r13, 00
    LDI     r2, r13, 04
    LDI     r3, r13, 08
    LDI     r4, r13, 12
    LDI     r12, r13, 16
    ADDI    r13, r13, 20

    MULI    r6, r4, 128
    ADD     r6, r6, r3      # index = y * 128 + x
    
    LDB     r0, r1, r6    # cell = alive cells[index]
    B       E, dead            # if (cell == 0) goto dead

  alive:
    SUBI    r0, r5, 2       # if (count < 2)
    B       LT, set_dead        #   goto set_dead
    SUBI    r0, r5, 3       # else if (count > 3)
    B       GT, set_dead        #   goto set_dead
    B       A, set_alive       # else goto set_alive

  dead:
    SUBI    r0, r5, 3       # if (count == 3)
    B       E, set_alive       #   goto set_alive
    B       A, set_dead        # else goto set_dead

  set_alive:
    ADDI    r7, r0, 0x23
    STB     r7, r2, r6    # inactive cells[index] = '#'
    B       A, end

  set_dead:
    STB     r0, r2, r6    # inactive cells[index] = 0
    B       A, end

  end:
    JMPR    r0, r12, 0

# arg1: ptr to active cells
# arg2: ptr to inactive cells
function applyRules:
    ADD     r3, r0, r0          # y = 0
  
  outer:
    ADD     r4, r0, r0          # x = 0
    
  inner:
    ADD     r5, r0, r3
    MULI    r5, r5, 128
    ADD     r5, r5, r4          # index = y * 128 + x

  body:
    SUBI    r13, r13, 24
    STI     r1, r13, 00
    STI     r2, r13, 04
    STI     r3, r13, 08
    STI     r4, r13, 12
    STI     r5, r13, 16
    STI     r12, r13, 20
    
    ADD     r5, r0, r3

    ADD     r3, r0, r4
    ADD     r4, r0, r5   
    JMPI    r12, applyRulesToCell

    LDI     r1, r13, 00
    LDI     r2, r13, 04
    LDI     r3, r13, 08
    LDI     r4, r13, 12
    LDI     r5, r13, 16
    LDI     r12, r13, 20
    ADDI    r13, r13, 24

  increment:
    ADDI    r4, r4, 1           # x = x + 1
    SUBI    r0, r4, 128         # if (x < 128)
    B       LT, inner               #   goto inner

    ADDI    r3, r3, 1           # y = y + 1
    SUBI    r0, r3, 42          # if (y < 42)
    B       LT, outer               #   goto outer

    JMPR    r0, r12, 0                 # ret

# arg1: ptr to cells
function generateInitialCells:
    ADD     r2, r0, r0          # y = 0
  
  outer:
    ADD     r3, r0, r0          # x = 0
    
  inner:
    ADD     r4, r0, r2
    MULI    r4, r4, 128
    ADD     r4, r4, r3          # index = y * 128 + x

    ADDI    r5, r0, 2
    RAND    r0, r0, r5           # if (rand() % 3 == 0)
    B       E, alive               #   goto alive

  dead:
    ADD     r5, r0, r0          # char = 0
    B       A, store

  alive:
    ADDI    r5, r0, "#"         # char = '#'

  store:
    STB     r5, r1, r4        # cells[index] = char

  increment:
    ADDI    r3, r3, 1           # x = x + 1
    SUBI    r0, r3, 128         # if (x < 128)
    B       LT, inner               #   goto inner

    ADDI    r2, r2, 1           # y = y + 1
    SUBI    r0, r2, 42          # if (y < 42)
    B       LT, outer               #   goto outer

    JMPR    r0, r12, 0                 # ret


# arg1: ptr to cells
function drawCells:
    ADD     r2, r0, r0          # y = 0
  
  outer:
    ADD     r3, r0, r0          # x = 0
    
  inner:
    ADD     r4, r0, r2
    MULI    r4, r4, 128
    ADD     r4, r4, r3          # index = y * 128 + x

    MULI    r5, r4, 4           # console offset = index * 4
    
    ADDI    r6, r0, 0xFFFFFFu   # color = white
    STI     r6, r5, 0x1000

    LDB     r6, r1, r4        # cell = cells[index]
    STBI    r6, r5, 0x1003

    ADDI    r3, r3, 1           # x = x + 1
    SUBI    r0, r3, 128         # if (x < 128)
    B       LT, inner               #   goto inner

    ADDI    r2, r2, 1           # y = y + 1
    SUBI    r0, r2, 42          # if (y < 42)
    B       LT, outer               #   goto outer

    JMPR   r0, r12, 0                 # ret

segment: data
    active_cells_index = 0
    cells.B = 0
