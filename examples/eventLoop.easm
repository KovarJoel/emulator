segment: code

# runs an event loop and exits once 'q' (in lower case) was pressed
function main:
    ADDI    r1, r0, 0xFF

    ADDI    r2, r0, 0x00
    ADDI    r3, r0, $info
    LDB     r4, r3, r0

  print_loop:
    STBI    r1, r2, 0x1000
    STBI    r1, r2, 0x1001
    STBI    r1, r2, 0x1002
    STBI    r4, r2, 0x1003
    
    ADDI    r2, r2, 4
    ADDI    r3, r3, 1
    LDB     r4, r3, r0
    B       NE, print_loop

  event_loop:
    LDI     r1, r0, 0x7104    # r1 = size
    B       E, event_loop

    LDI     r2, r0, 0x7100    # r2 = begin
    LDBI    r3, r2, 0x7000    # r3 = event
    SUBI    r0, r3, 0x71      # r3 == 'q'
    B       E, end


    ADDI    r2, r2, 1         # r2 = begin + 1
    REMI    r2, r2, 256       # r2 = (begin + 1) % 256
    SUBI    r1, r1, 1         # r1 = size - 1
    STI     r1, r0, 0x7104
    STI     r2, r0, 0x7100
    B       A, event_loop
  
  end:
    HALT r0, r0, r0

segment: data
  info.B = "This program runs an infinite event loop. Press 'q' (lower case) to stop...", 0x00
