segment: code
 
# prints hello world to the console
function main:
    ADDI  r1, r0, 0xFF

    ADDI  r2, r0, 0x00
    ADDI  r3, r0, $hello_world_string
    LDB   r4, r3, r0

  loop:
    STBI  r1, r2, 0x1000
    STBI  r1, r2, 0x1001
    STBI  r1, r2, 0x1002
    STBI  r4, r2, 0x1003
    
    ADDI  r2, r2, 4
    ADDI  r3, r3, 1
    LDB   r4, r3, r0
    B     NE, loop

    HALT r0, r0, r0

segment: data
    hello_world_string.B = "Hello, World!", 0x0
